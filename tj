  <script>
  (function () {
    // ── CONFIG ───────────────────────────────────────────────
    var TRACKER_URL = window.location.protocol + '//' + window.location.hostname.split('.').slice(-2).join('.') + '/click';

    // ── PHONE CAPTURE ────────────────────────────────────────
    function readPhone() {
      // Prefer the value resolved by MultiTFN resolver
      if (window.__MULTITFN_PHONE__) {
        return String(window.__MULTITFN_PHONE__).replace(/[\s\-]+/g, '');
      }
      var el = document.getElementById("dynamicPhone");
      if (!el) return null;
      var phone = el.innerText.trim().replace(/[\s\-]+/g, '');
      return phone || null;
    }

    function waitForPhone(callback, tries) {
      if (tries === undefined) tries = 60; // 3 seconds max
      var phone = readPhone();
      if (phone) {
        callback(phone);
      } else if (tries > 0) {
        setTimeout(function () { waitForPhone(callback, tries - 1); }, 50);
      } else {
        callback("unknown");
      }
    }

    // ── FIRE CONVERSION ──────────────────────────────────────
    function fireConversion(phone) {
      BPixelJS.conversion({
        url: TRACKER_URL,
        tokens: {
          cnv_status:  "stay_1min",
          cnv_status2: phone
        }
      });
      console.log("✅ conversion fired | stay_1min |", phone);
    }

    // ── RUN ──────────────────────────────────────────────────
    function start() {
      waitForPhone(fireConversion);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
  </script>

